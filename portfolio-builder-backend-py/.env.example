# Django backend config. Copy to .env for local dev — defaults below already
# target the docker-compose stack shared with the (legacy) Java backend.

DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production
DJANGO_DEBUG=True

# PostgreSQL (docker-compose: host port 5633 -> 5432)
DB_HOST=localhost
DB_PORT=5633
DB_NAME=portfolio_builder
DB_USER=portfolio_user
DB_PASSWORD=portfolio_pass

# MongoDB (docker-compose: host port 27018 -> 27017) — portfolio documents, styles
MONGODB_URI=mongodb://portfolio_user:portfolio_pass@localhost:27018/dzigned?authSource=admin

# JWT — must match the frontend's expectations (sub/email/type claims, HS256)
JWT_SECRET=default-dev-secret-change-in-production
JWT_ACCESS_EXPIRATION_SECONDS=3600
JWT_REFRESH_EXPIRATION_SECONDS=604800

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# LLM style generation (Gemini) — leave GEMINI_API_KEY blank to disable live generation
GEMINI_API_KEY=
LLM_DEFAULT_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_RATE_PER_MINUTE=5
LLM_RATE_PER_DAY=5

# Cloudinary (file storage) — leave blank to disable real uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub OAuth — leave client id/secret blank to disable a real OAuth round-trip
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/api/github/callback
GITHUB_SCOPE=public_repo
GITHUB_FRONTEND_SUCCESS_URL=http://localhost:5173
