{
  "theme": {
    "mode": "light",
    "colors": {
      "bg":         "#F5F4EF",
      "bgElevated": "#FFFFFF",
      "accent1":    "#4F46E5",
      "accent2":    "#7C3AED",
      "text":       "#1C1917",
      "textDim":    "#78716C",
      "textMuted":  "#8C867C",
      "shadow":     "rgba(0, 0, 0, 0.08)"
    }
  },

  "typography": {
    "headingFont":    "Playfair Display",
    "bodyFont":       "DM Sans",
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=DM+Sans:wght@300;400;500&display=swap",
    "scale":          "expressive",
    "weight":         "regular",
    "headingCase":    "none"
  },

  "backdrop": {
    "base":     "solid",
    "pattern":  "none",
    "glow":     "spotlight",
    "texture":  "none",
    "vignette": false
  },

  "depth": {
    "elevation":       "layered",
    "shadowQuality":   "soft",
    "surfaceContrast": "medium"
  },

  "surface": {
    "radius":       "soft",
    "borderWeight": "hairline",
    "contentWidth": "standard"
  },

  "components": {
    "card":         "shadow",
    "tag":          "outline",
    "button":       { "primary": "filled", "secondary": "ghost" },
    "sectionLabel": "badge",
    "socialIcon":   "outline",
    "avatar":       { "shape": "rounded-square", "frame": "spotlight" }
  },

  "sections": {
    "hero":           "overlay-typographic",
    "experience":     "split-rail",
    "education":      "compact",
    "projects":       "alternating",
    "certifications": "badges",
    "research":       "cards",
    "testimonials":   "stack",
    "contact":        "card"
  },

  "motion": {
    "intensity": "subtle",
    "entrance":  "fade",
    "cardHover": "lift",
    "linkHover": "underline",
    "counters":  "off"
  }
}
